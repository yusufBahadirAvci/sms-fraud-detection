# Python cache files (created automatically, not needed in Git)
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environment (each person creates their own)
.venv/
venv/

# PyCharm settings (personal to each computer)
.idea/

# Raw data is downloaded by the "prepare" stage, so Git does not need it.
# We do NOT ignore all of data/ here: DVC writes its own small .gitignore
# files (data/.gitignore, models/.gitignore) for the outputs it manages.
data/raw/

# MLflow runs and registered models (local tracking store).
mlruns/

# Log files are created each run; they are not source code.
logs/

# Build / packaging output
build/
dist/
*.egg-info/
